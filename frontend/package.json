{
  "name": "frontend",
  "productName": "Switchboard",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "Switchboard Desktop Application (Electron + React + Tailwind CSS)",
  "author": {
    "name": "aiyu-ayaan"
  },
  "homepage": "https://github.com/aiyu-ayaan/Switchboard",
  "repository": {
    "type": "git",
    "url": "https://github.com/aiyu-ayaan/Switchboard.git"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-qr-code": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.8"
  },
  "main": "electron/main.cjs",
  "desktopName": "switchboard.desktop",
  "scripts": {
    "dev": "vite --port 5273 --strictPort",
    "dev:electron": "SWITCHBOARD_DEV=1 SWITCHBOARD_PROFILE=dev electron . --no-sandbox",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "package:linux": "electron-builder --linux",
    "package:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.switchboard.desktop",
    "productName": "Switchboard",
    "executableName": "switchboard-desktop",
    "files": [
      "electron/**",
      "dist/**",
      "build/tray.png",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../target/release/",
        "to": "bin/",
        "filter": [
          "switchboard",
          "switchboard.exe"
        ]
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "linux": {
      "maintainer": "aiyu-ayaan <aiyu-ayaan@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "synopsis": "Control this computer from your phone"
    },
    "deb": {
      "packageName": "switchboard",
      "compression": "xz"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}

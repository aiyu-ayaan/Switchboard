<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone: the vault key lives in this device's Keystore. -->
<data-extraction-rules>
    <cloud-backup><exclude domain="root" /><exclude domain="file" /><exclude domain="sharedpref" /><exclude domain="database" /></cloud-backup>
    <device-transfer><exclude domain="root" /><exclude domain="file" /><exclude domain="sharedpref" /><exclude domain="database" /></device-transfer>
</data-extraction-rules>

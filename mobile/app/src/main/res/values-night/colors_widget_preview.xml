<?xml version="1.0" encoding="utf-8"?>
<!--
  Colours for the launcher's widget-picker preview only. The live widget takes
  its colours from GlanceTheme at runtime; a preview layout is plain XML and
  cannot, so it borrows the same dynamic palette the framework exposes.

  android:previewLayout is API 31+, which is also where these system_* colours
  start, so nothing below this reaches an older device.
-->
<resources>
    <color name="widget_preview_surface_color">@android:color/system_neutral1_900</color>
    <color name="widget_preview_card_color">@android:color/system_accent2_800</color>
    <color name="widget_preview_button_color">@android:color/system_neutral1_1000</color>
    <color name="widget_preview_accent_color">@android:color/system_accent1_200</color>
    <color name="widget_preview_on_surface_color">@android:color/system_neutral1_50</color>
    <color name="widget_preview_on_card_color">@android:color/system_accent1_100</color>
</resources>

{
  "name": "switchboard",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform system control and file transfer via mobile device",
  "scripts": {
    "dev": "node scripts/runner.mjs dev",
    "dev:backend": "node scripts/runner.mjs dev:backend",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "node scripts/runner.mjs build",
    "build:backend": "node scripts/runner.mjs build:backend",
    "build:frontend": "pnpm --filter frontend build",
    "android:build": "node scripts/android.mjs assembleDebug",
    "android:run": "node scripts/android.mjs run",
    "android:test": "node scripts/android.mjs testDebugUnitTest",
    "gateway": "node scripts/gateway.mjs",
    "package": "pnpm build:backend && pnpm build:frontend && pnpm --filter frontend package",
    "android:release": "node scripts/android.mjs assembleRelease"
  },
  "keywords": [
    "switchboard",
    "remote-control",
    "electron",
    "android",
    "go"
  ],
  "license": "MIT"
}
